# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

aws_region   = "us-west-2"
project_name = "vm-infrastructure"
environment  = "dev"
owner        = "infrastructure-team"
cost_center  = "engineering"

# Network Configuration
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.20.0/24"]

# Instance Configuration
instance_type = "t3.micro"
vm_count      = 5

# Security Configuration
# IMPORTANT: Replace with your actual IP address/CIDR blocks
# You can find your IP at: https://whatismyipaddress.com/
# Format: ["YOUR_IP/32"] or ["YOUR_OFFICE_CIDR/24"]
allowed_ssh_cidrs = ["203.0.113.0/32"]  # Replace with your IP

# Optional: Specify existing key pair name for EC2 access
# If not specified, you can use AWS Systems Manager Session Manager
key_pair_name = "my-key-pair"  # Replace with your key pair name

# Monitoring
enable_detailed_monitoring = true